# SUSFS is built against Android kernels that frequently backport individual
# MM/VFS APIs without updating LINUX_VERSION_CODE. Probe the actual source
# surface instead of assuming that a nominal kernel version has every API from
# the matching upstream release.
ifeq ($(shell grep -Eq \
	'struct[[:space:]]+maple_tree[[:space:]]+mm_mt[[:space:]]*;' \
	$(srctree)/include/linux/mm_types.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_MM_MT
endif
ifeq ($(shell grep -q "mmap_read_lock_killable" \
	$(wildcard $(srctree)/include/linux/mmap_lock.h \
		$(srctree)/include/linux/mm.h) \
	2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_MMAP_LOCK
endif
ifeq ($(shell grep -q "down_read_killable" \
	$(srctree)/include/linux/rwsem.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_DOWN_READ_KILLABLE
endif
ifeq ($(shell grep -q "mmget_not_zero" \
	$(wildcard $(srctree)/include/linux/sched/mm.h \
		$(srctree)/include/linux/sched.h) 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_MMGET_NOT_ZERO
endif
ifneq ($(wildcard $(srctree)/include/linux/sched/mm.h),)
ccflags-y += -DKSU_SUSFS_HAS_SCHED_MM
endif
ifeq ($(shell grep -q "show_map_pad_vma" \
	$(srctree)/include/linux/pgsize_migration.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_PGSIZE_MIGRATION
endif
ifeq ($(shell grep -Fq "struct vm_area_struct *pad" \
	$(srctree)/include/linux/pgsize_migration.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_SHOW_MAP_PAD_VMA_HAS_PAD
endif
ifeq ($(shell grep -q "get_data_vma" \
	$(srctree)/include/linux/pgsize_migration.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_PGSIZE_MIGRATION_VMA_ACCESSORS
endif
ifeq ($(shell grep -q "vma_get_anon_name" \
	$(wildcard $(srctree)/include/linux/mm_types.h \
		$(srctree)/include/linux/mm.h) \
	2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_VMA_ANON_NAME
endif
ifeq ($(shell grep -F "get_user_pages_remote" \
	$(srctree)/include/linux/mm.h 2>/dev/null | \
	grep -Fq "struct task_struct"; echo $$?),0)
ccflags-y += -DKSU_SUSFS_GUP_REMOTE_HAS_TASK
endif
ifeq ($(shell grep -Fq 'struct vm_area_struct **vmas' \
	$(srctree)/include/linux/mm.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_GUP_REMOTE_HAS_VMAS
endif
ifeq ($(shell grep -Fq "**vmas, int *locked" \
	$(srctree)/include/linux/mm.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_GUP_REMOTE_HAS_LOCKED
endif
ifeq ($(shell grep -q "page_is_young" \
	$(srctree)/include/linux/page_idle.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_PAGE_IDLE
endif
ifeq ($(shell grep -q "xa_is_value" \
	$(srctree)/include/linux/xarray.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_XA_IS_VALUE
endif
ifeq ($(shell grep -q "seq_put_hex_ll" \
	$(srctree)/include/linux/seq_file.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_SEQ_PUT_HEX_LL
endif
ifeq ($(shell grep -q "seq_put_decimal_ull_width" \
	$(srctree)/include/linux/seq_file.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_SEQ_PUT_DECIMAL_ULL_WIDTH
endif
ifeq ($(shell grep -Eq '[[:space:]]version[[:space:]]*;' \
	$(srctree)/include/linux/seq_file.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_SEQ_FILE_HAS_VERSION
endif
ifeq ($(shell grep -q "struct mm_walk_ops" \
	$(wildcard $(srctree)/include/linux/pagewalk.h \
		$(srctree)/include/linux/mm.h) \
	2>/dev/null; echo $$?),0)
