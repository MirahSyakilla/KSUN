kernelsu-objs := core/init.o

# Android vendor trees frequently backport syscall wrappers and LSM layout
# changes without updating LINUX_VERSION_CODE. Keep these probes global because
# the Kprobes backend needs them even when SUSFS itself is disabled.
ifeq ($(CONFIG_ARM64),y)
ifeq ($(shell grep -Fq "syscall_fn_t" \
	$(srctree)/arch/arm64/include/asm/syscall.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_ARM64_HAS_PTREGS_SYSCALL
endif
ifeq ($(shell grep -F "syscall_fn_t" \
	$(srctree)/arch/arm64/include/asm/syscall.h 2>/dev/null | \
	grep -Fq "const struct pt_regs"; echo $$?),0)
ccflags-y += -DKSU_ARM64_PTREGS_SYSCALL_CONST
endif
endif
ifeq ($(shell grep -Eq \
	'struct[[:space:]]+hlist_node[[:space:]]+list[[:space:]]*;' \
	$(srctree)/include/linux/lsm_hooks.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_LSM_HOOKS_USE_HLIST
endif
ifeq ($(shell grep -q "ksys_close" \
	$(srctree)/include/linux/syscalls.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_HAS_KSYS_CLOSE
endif
ifeq ($(shell grep -q "ksys_unshare" \
	$(srctree)/include/linux/syscalls.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_HAS_KSYS_UNSHARE
endif
ifeq ($(shell grep -E 'extern[[:space:]]+int[[:space:]]+close_fd' \
	$(srctree)/include/linux/fdtable.h 2>/dev/null | \
	grep -Fvq 'close_fd_get_file'; echo $$?),0)
ccflags-y += -DKSU_HAS_CLOSE_FD
endif

