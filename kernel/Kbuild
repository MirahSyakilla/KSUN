	$(srctree)/include/linux/fs.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_ITERATE
endif
# The readlink face resolves the caller's pathname the way do_readlinkat()
# does.  Upstream retired user_path_at_empty() in v5.8 (commit
# dff60734fc760, "vfs: retire user_path_at_empty and drop empty arg from
# getname_flags") and folded the empty-path handling into user_path_at();
# before that the function existed since v3.2.  The shape is therefore
# selected from the source tree, not from LINUX_VERSION_CODE: a vendor tree
# that backported the retirement (or did not) must get the matching call.
ifeq ($(shell grep -q "user_path_at_empty" \
	$(srctree)/include/linux/namei.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_USER_PATH_AT_EMPTY
endif
ifeq ($(shell grep -q "define LOOKUP_EMPTY" \
	$(srctree)/include/linux/namei.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_LOOKUP_EMPTY
endif
# The kallsyms face patches the show callback of the kernel's own
# kallsyms seq_operations table.  That table is a *static* object, so it is
# only listed in /proc/kallsyms - and therefore only resolvable - when the
# kernel exports every symbol.  Without it the face cannot be armed at all
# and says so instead of pretending to hide something.
ifeq ($(CONFIG_KALLSYMS_ALL),y)
ccflags-y += -DKSU_SUSFS_HAS_KALLSYMS_ALL
endif
endif

