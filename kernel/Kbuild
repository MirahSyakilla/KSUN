# SUSFS is built against Android kernels that frequently backport individual
# MM/VFS APIs without updating LINUX_VERSION_CODE. Probe the actual source
# surface instead of assuming that a nominal kernel version has every API from
# the matching upstream release.
ifeq ($(shell grep -Eq \
	'struct[[:space:]]+maple_tree[[:space:]]+mm_mt[[:space:]]*;' \
	$(srctree)/include/linux/mm_types.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_MM_MT
endif
ifeq ($(shell grep -q "mmap_read_lock_killable" \
	$(wildcard $(srctree)/include/linux/mmap_lock.h \
		$(srctree)/include/linux/mm.h) \
	2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_MMAP_LOCK
endif
ifeq ($(shell grep -q "down_read_killable" \
	$(srctree)/include/linux/rwsem.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_SUSFS_HAS_DOWN_READ_KILLABLE
endif
ifeq ($(shell grep -q "mmget_not_zero" \
	$(wildcard $(srctree)/include/linux/sched/mm.h \
		$(srctree)/include/linux/sched.h) 2>/dev/null; echo $$?),0)
