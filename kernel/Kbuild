ccflags-y += -I$(KSU_KERNEL_DIR) -I$(KSU_KERNEL_DIR)/include

# preinit runner: a static nolibc binary embedded into kernelsu, see preinit/.
# It is built against the UAPI headers of the target kernel: the installed
# ones (CONFIG_HEADERS_INSTALL) when they are present, otherwise the in-tree
# uapi headers plus the asm-generic ones the kernel generates into
# $(objtree)/arch/$(SRCARCH)/include/generated/uapi/asm.
KSU_UAPI_INC := $(objtree)/usr/include
ifneq ($(wildcard $(KSU_UAPI_INC)/linux/unistd.h),)
KSU_UAPI_INCFLAGS := -I$(KSU_UAPI_INC)
else
KSU_UAPI_INC := $(srctree)/include/uapi
KSU_UAPI_INCFLAGS := -I$(srctree)/include/uapi \
	-I$(srctree)/arch/$(SRCARCH)/include/uapi \
	-I$(objtree)/arch/$(SRCARCH)/include/generated/uapi \
	-I$(objtree)/include/generated/uapi \
	-I$(srctree)/include
endif

# The runner is swapped in through the execve hook, so it needs the hook
# core. Without it the whole feature is compiled out (KSU_NO_PREINIT).
#
# It also needs a kernel that can hand out an unlinked in-memory file:
# shmem_file_setup() lives in mm/shmem.c, which is only built when the
# kernel carries the shmem filesystem (CONFIG_SHMEM).  A kernel without it
# cannot stage the runner at all, so the feature is compiled out there too
# rather than failing to build.
KSU_HAS_SHMEM_FILE_SETUP := $(if $(CONFIG_SHMEM),$(shell grep -q \
	"shmem_file_setup" $(srctree)/include/linux/shmem_fs.h 2>/dev/null && \
	echo 1),)
ifeq ($(CONFIG_KSU_HOOK_CORE),y)
ifeq ($(KSU_HAS_SHMEM_FILE_SETUP),1)
kernelsu-objs += preinit/preinit.o
kernelsu-objs += preinit/blob.o

KSU_RUNNER_CFLAGS := $(CLANG_FLAGS) -std=gnu11 -Os -Wall \
	-nostdinc -isystem $(shell $(CC) -print-file-name=include) \
	-I$(KSU_KERNEL_DIR)/preinit/runner/nolibc $(KSU_UAPI_INCFLAGS) \
	-I$(KSU_KERNEL_DIR)/include -D__EXPORTED_HEADERS__ \
	-ffreestanding -fno-stack-protector -fno-pic -fno-pie \
	-fno-asynchronous-unwind-tables -fno-unwind-tables \
	-ffunction-sections -fdata-sections

quiet_cmd_ksu_runner = RUNNER  $@
      cmd_ksu_runner = $(CC) $(KSU_RUNNER_CFLAGS) -c -o $@.o $< && \
		$(LD) -static -nostdlib -e _start --gc-sections -s -o $@ $@.o && \
		rm -f $@.o

$(obj)/preinit/runner.elf: $(KSU_KERNEL_DIR)/preinit/runner/runner.c \
		$(wildcard $(KSU_KERNEL_DIR)/preinit/runner/nolibc/*.h \
			   $(KSU_KERNEL_DIR)/preinit/runner/nolibc/sys/*.h \
			   $(KSU_KERNEL_DIR)/include/uapi/*.h) FORCE
	$(call if_changed,ksu_runner)

targets += preinit/runner.elf
$(obj)/preinit/blob.o: $(obj)/preinit/runner.elf
asflags-y += -DKSU_PREINIT_RUNNER_BIN=\"$(obj)/preinit/runner.elf\"
else
$(warning -- KernelSU: preinit needs shmem_file_setup() (CONFIG_SHMEM), preinit disabled)
ccflags-y += -DKSU_NO_PREINIT
endif
else
$(warning -- KernelSU: preinit needs CONFIG_KSU_HOOK_CORE, preinit disabled)
ccflags-y += -DKSU_NO_PREINIT
endif

obj-$(CONFIG_KSU) += kernelsu.o

LPATH := /usr/bin/env PATH="$$PATH":/usr/bin:/usr/local/bin
KSU_MAKEFILE := $(lastword $(MAKEFILE_LIST))
KSU_MAKEFILE_REAL := $(realpath $(KSU_MAKEFILE))
ifneq ($(KSU_MAKEFILE_REAL),)
MDIR := $(dir $(KSU_MAKEFILE_REAL))
else
MDIR := $(dir $(abspath $(KSU_MAKEFILE)))
endif
KSU_VERSION_FILE := $(MDIR)/.ksu_git_version
KSU_VERSION_METADATA_FILE := $(MDIR)/VERSION
KSU_VERSION_OVERRIDE_VALUE := $(strip $(KSU_VERSION_OVERRIDE))
KSU_VERSION_TAG_OVERRIDE_VALUE := $(strip $(KSU_VERSION_TAG_OVERRIDE))

# Resolve a complete version pair without network access during Makefile parsing.
ifneq ($(and $(KSU_VERSION_OVERRIDE_VALUE),$(KSU_VERSION_TAG_OVERRIDE_VALUE)),)
KSU_VERSION_SOURCE := environment
KSU_GIT_VERSION := $(KSU_VERSION_OVERRIDE_VALUE)
KSU_GIT_TAG := $(KSU_VERSION_TAG_OVERRIDE_VALUE)
else
GIT_ROOT := $(shell cd $(MDIR) && $(LPATH) git rev-parse --show-toplevel 2>/dev/null)
ifneq ($(GIT_ROOT),)
KERNEL_GIT_ROOT := $(shell cd $(srctree) && $(LPATH) git rev-parse --show-toplevel 2>/dev/null)
ifneq ($(GIT_ROOT),$(KERNEL_GIT_ROOT))
KSU_GIT_VERSION := $(shell cd $(GIT_ROOT) && $(LPATH) git rev-list --count HEAD 2>/dev/null)
KSU_GIT_TAG := $(shell cd $(GIT_ROOT) && $(LPATH) git describe --tags --always 2>/dev/null)
ifneq ($(KSU_GIT_VERSION),)
KSU_VERSION_SOURCE := git
endif
endif
endif
ifneq ($(KSU_VERSION_SOURCE),git)
KSU_FILE_VERSION := $(shell sed -n 's/^KSU_VERSION_CODE=//p' $(KSU_VERSION_METADATA_FILE) 2>/dev/null)
KSU_FILE_TAG := $(shell sed -n 's/^KSU_VERSION_TAG=//p' $(KSU_VERSION_METADATA_FILE) 2>/dev/null)
ifneq ($(and $(KSU_FILE_VERSION),$(KSU_FILE_TAG)),)
KSU_VERSION_SOURCE := file
KSU_GIT_VERSION := $(KSU_FILE_VERSION)
KSU_GIT_TAG := $(KSU_FILE_TAG)
else
KSU_STAMP_VERSION := $(shell sed -n '1p' $(KSU_VERSION_FILE) 2>/dev/null)
KSU_STAMP_TAG := $(shell sed -n '2p' $(KSU_VERSION_FILE) 2>/dev/null)
ifneq ($(and $(KSU_STAMP_VERSION),$(KSU_STAMP_TAG)),)
KSU_VERSION_SOURCE := stamp
KSU_GIT_VERSION := $(KSU_STAMP_VERSION)
KSU_GIT_TAG := $(KSU_STAMP_TAG)
endif
endif
endif
endif

KSU_GIT_VERSION := $(strip $(KSU_GIT_VERSION))
KSU_GIT_TAG := $(strip $(KSU_GIT_TAG))

ifneq ($(KSU_VERSION_SOURCE),)
# ksu_version: major * 30000 + git version for historical reasons
ifneq ($(filter environment file,$(KSU_VERSION_SOURCE)),)
$(eval KSU_VERSION=$(KSU_GIT_VERSION))
else
$(eval KSU_VERSION=$(shell expr 30000 + $(KSU_GIT_VERSION)))
endif
$(info -- KernelSU-Next version source: $(KSU_VERSION_SOURCE))
$(info -- KernelSU-Next version: $(KSU_VERSION))
ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
else
$(warning "KernelSU-Next version metadata unavailable; using unknown build marker")
KSU_VERSION_FALLBACK := 1
$(info -- KernelSU-Next version fallback: $(KSU_VERSION_FALLBACK))
ccflags-y += -DKSU_VERSION=$(KSU_VERSION_FALLBACK)
endif

ifneq ($(KSU_GIT_TAG),)
$(eval KSU_VERSION_TAG=$(KSU_GIT_TAG))
$(info -- KernelSU-Next tag: $(KSU_VERSION_TAG))
ccflags-y += -DKSU_VERSION_TAG=\"$(KSU_VERSION_TAG)\"
else
$(warning "KernelSU-Next version tag unavailable; using unknown build marker")
KSU_VERSION_TAG_FALLBACK := v0.0.0
$(info -- KernelSU-Next tag fallback: $(KSU_VERSION_TAG_FALLBACK))
ccflags-y += -DKSU_VERSION_TAG=\"$(KSU_VERSION_TAG_FALLBACK)\"
endif

KSU_NEW_DCACHE_FLUSH := $(shell grep -q __flush_dcache_area $(srctree)/arch/arm64/include/asm/cacheflush.h ; echo $$?)
$(info -- KernelSU-Next new DCACHE flush: $(KSU_NEW_DCACHE_FLUSH))

# SELinux drivers check
ifeq ($(shell grep -q "current_sid(void)" $(srctree)/security/selinux/include/objsec.h; echo $$?),0)
ccflags-y += -DKSU_COMPAT_HAS_CURRENT_SID
endif
ifeq ($(shell grep -q "struct selinux_state " $(srctree)/security/selinux/include/security.h; echo $$?),0)
$(info -- $(REPO_NAME)/compat: selinux_state found)
ccflags-y += -DKSU_COMPAT_USE_SELINUX_STATE
endif

# Handle optional backports
ifeq ($(shell grep -q "strncpy_from_user_nofault" $(srctree)/include/linux/uaccess.h; echo $$?),0)
ccflags-y += -DKSU_OPTIONAL_STRNCPY
endif

ifeq ($(shell grep -q "ssize_t kernel_read" $(srctree)/fs/read_write.c; echo $$?),0)
ccflags-y += -DKSU_OPTIONAL_KERNEL_READ
endif

ifeq ($(shell grep "ssize_t kernel_write" $(srctree)/fs/read_write.c | grep -q "const void" ; echo $$?),0)
ccflags-y += -DKSU_OPTIONAL_KERNEL_WRITE
endif

ifeq ($(shell grep -q "int\s\+path_umount" $(srctree)/fs/namespace.c; echo $$?),0)
ccflags-y += -DKSU_HAS_PATH_UMOUNT
endif

# Some Android kernels backport faccessat2-style flags into do_faccessat()
# without matching upstream version numbers.
ifeq ($(shell grep -F "long do_faccessat" \
	$(srctree)/fs/open.c 2>/dev/null | \
	grep -Fq "flags"; echo $$?),0)
ccflags-y += -DKSU_HAS_FACCESSAT2
endif

# Exec helper layout is frequently backported independently of the nominal
# kernel version. Prefer the source shape when selecting branch-link ABI.
ifeq ($(shell grep -Fq "__do_execve_file" \
	$(srctree)/fs/exec.c 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_EXECVE_LEGACY_HELPER
else ifeq ($(shell grep -Fq "do_execveat_common" \
	$(srctree)/fs/exec.c 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_EXECVE_COMMON_HELPER
endif
ifeq ($(shell grep -Fq "__NR_execveat" \
	$(srctree)/arch/arm64/include/asm/unistd32.h 2>/dev/null; echo $$?),0)
ccflags-y += -DKSU_HAS_COMPAT_EXECVEAT
endif

# openat2 restructured the open family in 5.6 (fddb5d430ad9): do_sys_open
# tail-calls do_sys_openat2 and may lose its own BL to do_filp_open.  Detect
# the shape from the uapi header, not from LINUX_VERSION_CODE.
ifeq ($(shell test -f $(srctree)/include/uapi/linux/openat2.h; echo $$?),0)
ccflags-y += -DKSU_HAS_OPENAT2
endif

# seccomp_types.h was added in 6.7
ifeq ($(shell grep -q "atomic_t\s\+filter_count" $(srctree)/include/linux/seccomp.h $(srctree)/include/linux/seccomp_types.h; echo $$?),0)
ccflags-y += -DKSU_OPTIONAL_SECCOMP_FILTER_CNT
endif

# some old kernels backport this, so check whether put_seccomp_filter still exists
ifneq ($(shell grep -wq "put_seccomp_filter" $(srctree)/kernel/seccomp.c $(srctree)/include/linux/seccomp.h; echo $$?),0)
ccflags-y += -DKSU_OPTIONAL_SECCOMP_FILTER_RELEASE
endif

# Checks Samsung
ifeq ($(shell grep -q "CONFIG_KDP_CRED" $(srctree)/kernel/cred.c; echo $$?),0)
ccflags-y += -DSAMSUNG_UH_DRIVER_EXIST
endif

ifeq ($(shell grep -q "SEC_SELINUX_PORTING_COMMON" $(srctree)/security/selinux/avc.c; echo $$?),0)
ccflags-y += -DSAMSUNG_SELINUX_PORTING
endif

# policy mutex
# kernel 5.10+
ifeq ($(shell grep -q "policy_mutex" $(srctree)/security/selinux/include/security.h; echo $$?),0)
ccflags-y += -DKSU_COMPAT_HAS_POLICY_MUTEX
endif

# Android SPEC Changes
# https://android-review.googlesource.com/c/kernel/common/+/3009995
ifeq ($(shell grep -q "POLICYDB_CONFIG_ANDROID_NETLINK_ROUTE" $(srctree)/security/selinux/ss/policydb.h; echo $$?),0)
ccflags-y += -DKSU_COMPAT_HAS_POLICYDB_CONFIG_ANDROID_NETLINK_ROUTE
endif

ifeq ($(shell grep -q "POLICYDB_CONFIG_ANDROID_NETLINK_GETNEIGH" $(srctree)/security/selinux/ss/policydb.h; echo $$?),0)
ccflags-y += -DKSU_COMPAT_HAS_POLICYDB_CONFIG_ANDROID_NETLINK_GETNEIGH
endif

ifneq ($(shell grep -q "flex_array" $(srctree)/security/selinux/ss/policydb.h; echo $$?),0)
ccflags-y += -DKSU_COMPAT_HAS_MODERN_POLICYDB
endif

ifeq ($(shell grep -F -q "int (*setprocattr)(const char *name, void *value, size_t size);" $(srctree)/include/linux/lsm_hooks.h; echo $$?),0)
ccflags-y += -DKSU_COMPAT_SETPROCATTR_USE_NEW_PROTOTYPE
endif

ifeq ($(shell grep -F -q "char *lsm_names" $(srctree)/security/security.c; echo $$?),0)
ccflags-y += -DKSU_COMPAT_REQUIRE_PROVIDE_LSM_NAME
endif

# https://github.com/torvalds/linux/commit/4b36cb773a8153417a080f8025d522322f915aea
ifeq ($(shell grep -q "struct mutex status_lock" $(srctree)/security/selinux/include/security.h; echo $$?),0)
ccflags-y += -DKSU_COMPAT_SELINUX_STATUS_VAR_IN_SELINUX_STATE
endif

ifeq ($(shell grep -q "struct selinux_policy" $(srctree)/security/selinux/ss/services.h; echo $$?),0)
ccflags-y += -DKSU_COMPAT_HAS_SELINUX_POLICY_STRUCT
endif

# https://github.com/torvalds/linux/commit/24def7bb92c19337cee26d506f87dc4eeeba7a19
ifeq ($(shell grep -q "hashtab_key_params" $(srctree)/security/selinux/ss/hashtab.h; echo $$?),0)
ccflags-y += -DKSU_COMPAT_HAS_HASHTAB_KEY_PARAMS
endif

# https://github.com/torvalds/linux/commit/c3a276111ea2572399281988b3129683e2a6b60b
ifeq ($(shell grep -q "filename_trans_key" $(srctree)/security/selinux/ss/policydb.h; echo $$?),0)
ccflags-y += -DKSU_COMPAT_HAS_FILENAME_TRANS_KEY
endif


ifndef KSU_NEXT_MANAGER_SIZE
KSU_NEXT_MANAGER_SIZE := 0x3e6
endif

ifndef KSU_NEXT_MANAGER_HASH
KSU_NEXT_MANAGER_HASH := 79e590113c4c4c0c222978e413a5faa801666957b1212a328e46c00c69821bf7
endif

ifdef KSU_MANAGER_PACKAGE
ccflags-y += -DKSU_MANAGER_PACKAGE=\"$(KSU_MANAGER_PACKAGE)\"
$(info -- KernelSU-Next Manager package name: $(KSU_MANAGER_PACKAGE))
endif

$(info -- KernelSU-Next Manager signature size: $(KSU_NEXT_MANAGER_SIZE))
$(info -- KernelSU-Next Manager signature hash: $(KSU_NEXT_MANAGER_HASH))

ccflags-y += -DEXPECTED_MANAGER_SIZE=$(KSU_NEXT_MANAGER_SIZE)
ccflags-y += -DEXPECTED_MANAGER_HASH=\"$(KSU_NEXT_MANAGER_HASH)\"

ccflags-y += -DKSU_NEW_DCACHE_FLUSH=$(KSU_NEW_DCACHE_FLUSH)

ccflags-y += -Wno-strict-prototypes -Wno-int-conversion -Wno-gcc-compat -Wno-missing-prototypes
ccflags-y += -Wno-declaration-after-statement -Wno-unused-function -Wno-unused-variable

