export ARCH=arm64
export CLANG_TRIPLE=aarch64-linux-gnu-
export CROSS_COMPILE=aarch64-linux-gnu-
export CROSS_COMPILE_ARM32=arm-linux-gnueabihf-
export CROSS_COMPILE_COMPAT=arm-linux-gnueabihf-
export LLVM=1
export LLVM_IAS=1
export CC=clang
export LD=ld.lld
export AR=llvm-ar
export NM=llvm-nm
export OBJCOPY=llvm-objcopy
export OBJDUMP=llvm-objdump
export STRIP=llvm-strip
export READELF=llvm-readelf
export HOSTCC=clang
export HOSTCXX=clang++
export HOSTLD=ld.lld
export KCFLAGS="-O3 -mglobal-merge"
export CFLAGS_KERNEL="-Wno-error=implicit-enum-conversion -Wno-error=pointer-to-int-cast -Wno-error=unused-function -Wno-error=fortify-source -Wno-error=unused-label -Wno-error=incompatible-pointer-types -Wno-error=deprecated-non-prototype -Wno-error=implicit-function-declaration"
export PATH="$HOME/bin/zyc-clang/bin:$PATH"
